{
  "name": "escpos-print-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Agente local de referencia: recibe un TicketPrintJob por HTTP y lo imprime vía ESC/POS crudo en una impresora de red (puerto 9100).",
  "main": "index.js",
  "bin": "index.js",
  "scripts": {
    "start": "node index.js",
    "build": "pkg . --output dist/escpos-print-agent.exe"
  },
  "dependencies": {
    "node-thermal-printer": "^4.4.4"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.22.0"
  },
  "pkg": {
    "targets": ["node22-win-x64"],
    "outputPath": "dist"
  },
  "engines": {
    "node": ">=18"
  }
}
